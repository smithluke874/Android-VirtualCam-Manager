    bool semi = (colorFormat == 21 || colorFormat == 0x7F420888 || colorFormat == 0x7F000789);
    for (int dy = 0; dy < dstH; dy++) {
        int sy = dy * srcH / dstH;
        for (int dx = 0; dx < dstW; dx++)
            dst[dy * dstW + dx] = src[sy * srcStride + (dx * srcW / dstW)];
    }
    uint8_t *dstUV = dst + (size_t)dstW * dstH;
    for (int dy = 0; dy < dstH / 2; dy++) {
        int sy = dy * (srcH / 2) / (dstH / 2);
        for (int dx = 0; dx < dstW / 2; dx++) {
            int sx = dx * (srcW / 2) / (dstW / 2);
            uint8_t u, v;
