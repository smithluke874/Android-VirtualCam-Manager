                const uint8_t *vP = uP + (size_t)(srcW / 2) * (srcH / 2);
                u = uP[sy * (srcW / 2) + sx];
                v = vP[sy * (srcW / 2) + sx];
            }
            dstUV[dy * dstW + dx * 2] = v;
            dstUV[dy * dstW + dx * 2 + 1] = u;
        }
    }
}
