static void report_status(const char *pkg, const char *status) {
    FILE *f = fopen(kHookStatus, "w");
    if (f) { fputs(status, f); fclose(f); }
    f = fopen(kLastPkg, "w");
    if (f) { fputs(pkg, f); fclose(f); }
}
