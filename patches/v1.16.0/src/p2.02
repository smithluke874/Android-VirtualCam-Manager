                uint8_t *outBuf = AMediaCodec_getOutputBuffer(codec, outIdx, &outSize);
                if (outBuf && outSize > 0) {
                    std::lock_guard<std::mutex> lock(mu_);
                    size_t need = (size_t)targetW * (size_t)targetH * 3 / 2;
                    if (decode_buf_.size() == need && buf_.size() == need) {
                        convertToNv21(outBuf,
                                      srcW > 0 ? srcW : targetW,
                                      srcH > 0 ? srcH : targetH,
                                      stride > 0 ? stride : (srcW > 0 ? srcW : targetW),
                                      colorFormat,
                                      decode_buf_.data(), targetW, targetH);
                        buf_.swap(decode_buf_);
                        frame_count_++;
                        frames++;
                    }
                }
            }
            AMediaCodec_releaseOutputBuffer(codec, outIdx, false);
            errs = 0;

            // Soft pacing ~30 fps
            if (frames > 0 && (frames % 2) == 0)
                usleep(12000);
        } else if (outIdx == AMEDIACODEC_INFO_OUTPUT_FORMAT_CHANGED) {
            AMediaFormat *nf = AMediaCodec_getOutputFormat(codec);
            if (nf) {
                AMediaFormat_getInt32(nf, AMEDIAFORMAT_KEY_COLOR_FORMAT, &colorFormat);
                AMediaFormat_getInt32(nf, AMEDIAFORMAT_KEY_WIDTH, &srcW);
