    if (track < 0 || !fmt || !mime) {
        LOGE("decoder: no video track");
        if (fmt) AMediaFormat_delete(fmt);
        AMediaExtractor_delete(ex);
        video_mode_ = false;
        decoder_running_ = false;
        return;
    }

    AMediaExtractor_selectTrack(ex, track);
    AMediaFormat_getInt32(fmt, AMEDIAFORMAT_KEY_WIDTH, &srcW);
    AMediaFormat_getInt32(fmt, AMEDIAFORMAT_KEY_HEIGHT, &srcH);

    // Prefer semi-planar when possible; device may ignore and report actual format later
    AMediaFormat_setInt32(fmt, AMEDIAFORMAT_KEY_COLOR_FORMAT, 21);

    AMediaCodec *codec = AMediaCodec_createDecoderByType(mime);
    if (!codec || AMediaCodec_configure(codec, fmt, nullptr, nullptr, 0) != AMEDIA_OK) {
        LOGE("decoder: codec configure fail mime=%s", mime);
        if (codec) AMediaCodec_delete(codec);
        AMediaFormat_delete(fmt);
        AMediaExtractor_delete(ex);
        video_mode_ = false;
        decoder_running_ = false;
        return;
    }
    AMediaFormat_delete(fmt);
    fmt = nullptr;

    if (AMediaCodec_start(codec) != AMEDIA_OK) {
        LOGE("decoder: start fail");
        AMediaCodec_delete(codec);
        AMediaExtractor_delete(ex);
        video_mode_ = false;
        decoder_running_ = false;
        return;
    }

    LOGI("decoder: %s %dx%d -> %dx%d", mime, srcW, srcH, targetW, targetH);
    report_status(g_last_pkg, "nv21_video_ready");

