    return path && stat(path, &st) == 0 && S_ISREG(st.st_mode) && st.st_size > 0;
}

void Nv21FrameProvider::setVideoPath(const char *path) {
    std::lock_guard<std::mutex> lock(mu_);
    video_path_ = path ? path : "";
}
void Nv21FrameProvider::stop() {
    std::lock_guard<std::mutex> lock(mu_);
    stopDecoderLocked();
    video_mode_ = false;
    ready_ = false;
}
void Nv21FrameProvider::stopDecoderLocked() {
    stop_flag_ = true;
    if (decoder_thread_.joinable()) decoder_thread_.detach();
    decoder_running_ = false;
    stop_flag_ = false;
}
bool Nv21FrameProvider::startDecoderLocked() {
    if (video_path_.empty() || w_ <= 0 || h_ <= 0) return false;
    stop_flag_ = false;
    decoder_running_ = true;
    decoder_thread_ = std::thread([this]{ decoderLoop(); });
    return true;
}
void Nv21FrameProvider::fillPatternLocked() {
    if (buf_.empty() || w_ <= 0 || h_ <= 0) return;
    size_t ySize = (size_t)w_ * h_;
    memset(buf_.data(), 0x80, ySize);
    int barW = w_ / 16; if (barW < 4) barW = 4;
    for (int y = 0; y < h_; y++)
        for (int x = bar_x_; x < bar_x_ + barW && x < w_; x++)
            buf_[(size_t)y * w_ + x] = 0xE0;
    memset(buf_.data() + ySize, 0x80, buf_.size() - ySize);
}
bool Nv21FrameProvider::ensure(int w, int h) {
    if (w <= 0 || h <= 0) return false;
    std::lock_guard<std::mutex> lock(mu_);
    size_t need = (size_t)w * h * 3 / 2;
    bool changed = (w_ != w || h_ != h || buf_.size() != need);
    if (changed) {
